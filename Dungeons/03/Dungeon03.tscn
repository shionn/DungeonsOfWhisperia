text = "Ce livre semble contenir un indice sur la résolution de l’énigme.

[i]Attention : lire la suite vous privera de l’expérience gagnée lors de la résolution de l’énigme.[/i]"
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Lire la suite" type="Node" parent="RoomSouthEast/Meuble/paladin_book2/description" unique_id=1284942435]
script = ExtResource("49_e5ej3")
text = "Il faut que tous les jetons soient de la même couleur. Commencez par le deuxième jeton, en partant de la droite et du haut. Ensuite, prenez le deuxième jeton, en partant de la gauche sur la ligne du centre. 
En sortant de la pièce, les jetons reprendront leur position initiale."
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

