[node name="Crane" type="Node" parent="Items" unique_id=616656790]
script = ExtResource("5_p1v5b")
item_name = 5
icon = ExtResource("10_fvag4")
description = "Ceci est la preuve que j'ai accompli ma mission.

[i]Félicitations ! Vous avez accompli votre première quête, donnez le mot de passe [b]Crâne de golem[/b] et le montant d'or possédé à Shionn (Rurick) dans un message privé sur Discord.
Mais avez-vous tous fouillé ? Avez-vous trouvé toute la quantité d'or possible également ?

Merci sincèrement d’avoir participé à cette alpha. Shionn[/i]"
tooltip = "Crâne"
metadata/_custom_type_script = "uid://bjbab3ep2gfn2"

