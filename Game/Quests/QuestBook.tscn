[node name="Dungeon01" type="Node" parent="." unique_id=1685079018]
script = ExtResource("2_7pmna")
title = "Néttoyer le mausolé"
description = "Lorsque vous arrivez près du mausolée, vous ne croisez d’abord aucun mort-vivant… Mais les bruits étouffés de grognements et les ombres qui s’échappent de ces ruines vous mettent aussitôt en garde. Les créatures semblent sortir du mausolée lui-même, comme si leur présence était inscrite dans ses murs. Vous hésitez un instant, puis vous décidez de pénétrer à l’intérieur, déterminé à découvrir ce qui se cache derrière cette menace."
metadata/_custom_type_script = "uid://bx0atspqwloy6"

