[node name="Dungeon02" type="Node" parent="." unique_id=2040650321]
script = ExtResource("2_7pmna")
title = "Néttoyer le Gouffre des Ombres"
description = "En arrivant pret du lac d’argent, dont les eaux scintillent comme des lames de couteau sous la lumière de la lune. Au loin, des cris étouffés résonnent, semblant provenir des profondeurs du donjon.  
Dès que vous franchissez les portes de pierre, une magie noire vous enveloppe, suffocante et corrompue. L’air est lourd, chargé d’une odeur de pourriture et de sang séché. "
metadata/_custom_type_script = "uid://bx0atspqwloy6"

